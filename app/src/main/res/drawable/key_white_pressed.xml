<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state - no shadow, slightly indented feel -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape>
            <solid android:color="@color/key_white_pressed" />
            <corners
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp"
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp" />
            <stroke
                android:width="1dp"
                android:color="@color/key_white_stroke" />
        </shape>
    </item>
</layer-list>

