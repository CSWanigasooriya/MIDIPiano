<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item
        android:bottom="0dp"
        android:left="1dp"
        android:right="0dp"
        android:top="0dp">
        <shape>
            <solid android:color="#40000000" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Main key surface with slight gradient effect -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="2dp"
        android:top="0dp">
        <shape>
            <solid android:color="@color/key_black_normal" />
            <corners
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp"
                android:topLeftRadius="3dp"
                android:topRightRadius="3dp" />
            <stroke
                android:width="0.5dp"
                android:color="@color/key_black_stroke" />
        </shape>
    </item>
    <!-- Highlight strip at top -->
    <item
        android:bottom="0dp"
        android:left="2dp"
        android:right="4dp"
        android:top="0dp">
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="3dp" />
            <stroke
                android:width="0.5dp"
                android:color="#20FFFFFF" />
            <size android:height="8dp" />
        </shape>
    </item>
</layer-list>

