<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="com.flaze.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Instrument Selector -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/instrumentField"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/instrument_prompt"
                android:maxWidth="280dp"
                android:minWidth="160dp">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLines="1"
                    android:singleLine="true"
                    tools:text="Acoustic Grand Piano" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Octave Indicator Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/octaveChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="false"
                android:contentDescription="@string/cd_octave_indicator"
                android:focusable="false"
                android:text="@string/current_octave"
                app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:chipIcon="@drawable/ic_tune_24"
                app:chipIconTint="?attr/colorOnSurfaceVariant"
                tools:text="Oct 3-4" />

            <!-- Premium Button (shows if not pro) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/premiumButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cd_upgrade_button"
                android:minWidth="48dp"
                android:text="@string/premium_badge"
                android:textAllCaps="true"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_star_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp" />

            <!-- Controls Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/controlsButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/controls"
                app:icon="@drawable/ic_tune_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Ad banner at bottom in landscape - unobtrusive -->
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurfaceContainerLow"
        android:contentDescription="@string/cd_ad_banner" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <HorizontalScrollView
            android:id="@+id/horizontalScroller"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:fillViewport="true"
            android:importantForAccessibility="no">

            <RelativeLayout
                android:id="@+id/keyboardRoot"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="70dp">

                <!-- White keys -->
                <Button
                    android:id="@+id/c3"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="c3"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/d3"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/c3"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="d3"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/e3"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/d3"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="e3"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/f3"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/e3"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="f3"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/g3"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/f3"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="g3"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/a3"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/g3"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="a3"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/b3"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/a3"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="b3"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/c4"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/b3"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="c4"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/d4"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/c4"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="d4"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/e4"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/d4"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="e4"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/f4"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/e4"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="f4"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/g4"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/f4"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="g4"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/a4"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/g4"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="a4"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/b4"
                    android:layout_width="@dimen/white_key_width"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/a4"
                    android:background="@drawable/key_white"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:tag="b4"
                    tools:ignore="ContentDescription" />

                <!-- Black keys -->
                <Button
                    android:id="@+id/c3Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/c3"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="c3#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/d3Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/d3"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="d3#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/f3Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/f3"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="f3#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/g3Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/g3"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="g3#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/a3Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/a3"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="a3#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/c4Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/c4"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="c4#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/d4Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/d4"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="d4#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/f4Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/f4"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="f4#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/g4Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/g4"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="g4#"
                    tools:ignore="ContentDescription" />

                <Button
                    android:id="@+id/a4Sharp"
                    android:layout_width="@dimen/black_key_width"
                    android:layout_height="@dimen/black_key_height"
                    android:layout_marginStart="@dimen/black_key_offset"
                    android:layout_toEndOf="@id/a4"
                    android:background="@drawable/key_black"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:tag="a4#"
                    tools:ignore="ContentDescription" />

            </RelativeLayout>
        </HorizontalScrollView>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
